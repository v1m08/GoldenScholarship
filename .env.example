# Supabase (server only, never exposed to the browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# PostHog. Leave the key empty to run without analytics.
NEXT_PUBLIC_POSTHOG_KEY=
# "us" or "eu": must match the PostHog project
POSTHOG_REGION=us

# Public addresses, once they exist.
# The site's own address, no trailing slash, e.g. https://goldenscholarship.com
# On Vercel, leaving it empty falls back to the project's vercel.app address.
NEXT_PUBLIC_SITE_URL=
# The public GitHub repository. Shows a GitHub link in the header and Why page.
NEXT_PUBLIC_REPO_URL=
